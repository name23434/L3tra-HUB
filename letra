local function resetToSelf()
	spectating = false
	if player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
		end
	end
	setStatus("Sin observar a nadie", false, selectedPlayer)
	rebuildPlayerList()
end

updateCamera = function()
	refreshTargets()
	if #spectateList == 0 then
		resetToSelf()
		setStatus("No hay otros jugadores disponibles", false, nil)
		return
	end

	if targetIndex > #spectateList then
		targetIndex = 1
	elseif targetIndex < 1 then
		targetIndex = #spectateList
	end

	local targetPlayer = spectateList[targetIndex]
	if targetPlayer and targetPlayer.Character then
		local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			spectating = true
			selectedPlayer = targetPlayer
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
			setStatus("Observando a " .. targetPlayer.DisplayName, true, targetPlayer)
			rebuildPlayerList()
		end
	end
end

local function teleportToTarget()
	refreshTargets()
	local targetPlayer = selectedPlayer or spectateList[targetIndex]

	if not targetPlayer or not targetPlayer.Parent then
		setStatus("Selecciona un jugador en la lista para TP", spectating, nil)
		return
	end

	local targetChar = targetPlayer.Character
	local myChar = player.Character
	if not targetChar or not myChar then
		setStatus("Personaje no disponible para TP", spectating, targetPlayer)
		return
	end

	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not targetRoot or not myRoot then
		setStatus("Falta HumanoidRootPart para TP", spectating, targetPlayer)
		return
	end

	local destCFrame = targetRoot.CFrame * CFrame.new(0, 0, 3.5)
	if myChar.PrimaryPart then
		myChar:PivotTo(destCFrame)
	else
		myRoot.CFrame = destCFrame
	end

	setStatus("TP hacia " .. targetPlayer.DisplayName, spectating, targetPlayer)
end

-- Helper para calcular posición ligeramente desplazada al animar
local function getOffsetPosition(basePos, deltaX)
	return UDim2.new(basePos.X.Scale, basePos.X.Offset + deltaX, basePos.Y.Scale, basePos.Y.Offset)
end

-- Animación de abrir y cerrar menú
local function openMenu()
	if not hubFrame or not hubFrame.Parent then return end
	animToken += 1
	local currentToken = animToken

	cancelMenuTweens()
	isMenuOpen = true
	rebuildPlayerList()

	hubFrame.Position = getOffsetPosition(homePosition, -16)
	hubScale.Scale = 0.92
	hubFrame.Visible = true

	local posTween = TweenService:Create(hubFrame, OPEN_TWEEN, {Position = homePosition})
	local scaleTween = TweenService:Create(hubScale, OPEN_TWEEN, {Scale = 1})

	table.insert(activeTweens, posTween)
	table.insert(activeTweens, scaleTween)

	posTween:Play()
	scaleTween:Play()

	scaleTween.Completed:Connect(function(playbackState)
		if currentToken == animToken and playbackState == Enum.PlaybackState.Completed then
			hubScale.Scale = 1
			hubFrame.Position = homePosition
		end
	end)
end

local function closeMenu(callback)
	if not hubFrame or not hubFrame.Parent or not isMenuOpen then
		if callback then callback() end
		return
	end
	animToken += 1
	local currentToken = animToken

	cancelMenuTweens()
	isMenuOpen = false

	local posTween = TweenService:Create(hubFrame, CLOSE_TWEEN, {Position = getOffsetPosition(homePosition, -16)})
	local scaleTween = TweenService:Create(hubScale, CLOSE_TWEEN, {Scale = 0.92})

	table.insert(activeTweens, posTween)
	table.insert(activeTweens, scaleTween)

	posTween:Play()
	scaleTween:Play()

	scaleTween.Completed:Connect(function(playbackState)
		if currentToken == animToken then
			if hubFrame and hubFrame.Parent and playbackState ~= Enum.PlaybackState.Cancelled then
				hubFrame.Visible = false
			end
			if callback then
				callback()
			end
		end
	end)
end

local function toggleHub()
	if isMenuOpen then
		closeMenu()
	else
		openMenu()
	end
end

-- Cerrar y descargar el script por completo con animación
local function closeScript()
	resetToSelf()
	selectedPlayer = nil

	local function cleanup()
		cancelMenuTweens()

		-- Devolver los gráficos originales antes de destruir la UI
		if boostActive then
			boostActive = false
			restoreBoost()
		end

		table.clear(thumbnailCache)
		for _, conn in ipairs(connections) do
			if conn and conn.Connected then
				conn:Disconnect()
			end
		end
		table.clear(connections)

		if screenGui then
			screenGui:Destroy()
		end

		-- Anti-VCB no se descarga: sigue activo hasta salir del servidor.
		if script then
			script.Disabled = true
			script:Destroy()
		end
	end

	if isMenuOpen then
		closeMenu(cleanup)
	else
		cleanup()
	end
end


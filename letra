-- ===== ANTI-VCB =====
-- Se ejecuta una sola vez al cargar, aislado del resto del hub.
-- No se puede descargar: vive fuera del ScreenGui y persiste al cerrar el script.
local ANTI_VCB_URL = "https://raw.githubusercontent.com/imshrak/anti-vcb/refs/heads/main/main"

local function runAntiVCB()
	if type(game.HttpGet) ~= "function" then
		warn("[L3tra] Este executor no soporta HttpGet; Anti-VCB no se cargo.")
		return false
	end

	local ok, err = pcall(function()
		local source = game:HttpGet(ANTI_VCB_URL)
		local chunk, compileErr = loadstring(source)
		if not chunk then
			error("loadstring fallo: " .. tostring(compileErr))
		end
		return chunk()
	end)

	if not ok then
		warn("[L3tra] Error al cargar Anti-VCB: " .. tostring(err))
	end
	return ok
end


-- Cargar avatar del jugador con caché para evitar peticiones repetidas
local function applyPlayerAvatar(userId, imageLabel)
	if not imageLabel or not imageLabel.Parent then return end

	if thumbnailCache[userId] then
		imageLabel.Image = thumbnailCache[userId]
		return
	end

	task.spawn(function()
		local ok, content, isReady = pcall(function()
			return Players:GetUserThumbnailAsync(
				userId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
		end)

		if ok and isReady and content then
			thumbnailCache[userId] = content
			if imageLabel and imageLabel.Parent then
				imageLabel.Image = content
			end
		end
	end)
end


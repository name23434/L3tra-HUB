-- ===== MOTOR DEL FPS BOOST =====
local savedProps = {}
local hiddenInstances = {}
local boostActive = false
local boostLevel = "Medio"

-- Guarda el valor original una sola vez y aplica el nuevo
local function setProp(inst, prop, value)
	if not inst then return end
	local rec = savedProps[inst]
	if not rec then
		rec = {}
		savedProps[inst] = rec
	end
	local ok, current = pcall(function() return inst[prop] end)
	if not ok then return end
	if rec[prop] == nil then
		rec[prop] = current
	end
	pcall(function() inst[prop] = value end)
end

local function hideInstance(inst)
	if not inst or not inst.Parent then return end
	table.insert(hiddenInstances, {inst = inst, parent = inst.Parent})
	inst.Parent = nil
end

-- Recorrido por el mapa repartido entre frames para no congelar el juego
local function forEachDescendant(fn)
	task.spawn(function()
		local count = 0
		for _, inst in ipairs(workspace:GetDescendants()) do
			count += 1
			pcall(fn, inst)
			if count % 250 == 0 then
				task.wait()
			end
		end
	end)
end

local function setTerrainDetail(value)
	if not Terrain then return end
	local ok = pcall(function() Terrain:SetTerrainDetail(value) end)
	if not ok then
		pcall(function() Terrain:SetTerrainDetail(nil, value) end)
	end
end

local function applyBoost(level)
	local strength = 1
	if level == "Agresivo" then
		strength = 3
	elseif level == "Medio" then
		strength = 2
	end

	if UserGameSettings then
		pcall(function()
			setProp(UserGameSettings, "SavedQualityLevel", Enum.SavedQualitySetting.QualityLevel1)
		end)
	end

	setProp(Lighting, "GlobalShadows", false)
	setProp(Lighting, "EnvironmentDiffuseScale", 0)
	setProp(Lighting, "EnvironmentSpecularScale", 0)
	setProp(Lighting, "Brightness", 2)
	setProp(Lighting, "Ambient", Color3.fromRGB(90, 95, 105))
	setProp(Lighting, "OutdoorAmbient", Color3.fromRGB(110, 115, 125))

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") then
			setProp(child, "Enabled", false)
		end
	end

	if Terrain then
		pcall(function() setProp(Terrain, "WaterWaveSize", 0) end)
		pcall(function() setProp(Terrain, "WaterWaveSpeed", 0) end)
		pcall(function() setProp(Terrain, "WaterReflectance", 0) end)
		pcall(function() setProp(Terrain, "Decoration", false) end)
		pcall(function() setProp(Terrain, "GrassLength", 0) end)
		setTerrainDetail(1)
	end

	if strength >= 2 then
		setProp(Lighting, "FogEnd", strength >= 3 and 220 or 450)
	end

	forEachDescendant(function(inst)
		if inst:IsA("BasePart") then
			setProp(inst, "CastShadow", false)
		end

		if strength >= 2 then
			if inst:IsA("ParticleEmitter")
				or inst:IsA("Smoke")
				or inst:IsA("Fire")
				or inst:IsA("Sparkles")
				or inst:IsA("Beam")
				or inst:IsA("Trail") then
				setProp(inst, "Enabled", false)
			end
		end

		if strength >= 3 then
			if inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
				setProp(inst, "Enabled", false)
			end
			if inst:IsA("Decal") or inst:IsA("Texture") then
				setProp(inst, "Transparency", 1)
			end
		end
	end)

	if strength >= 3 then
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("Clouds") then
				hideInstance(child)
			end
		end
	end
end

local function restoreBoost()
	for _, entry in ipairs(hiddenInstances) do
		if entry.inst and entry.parent then
			pcall(function() entry.inst.Parent = entry.parent end)
		end
	end
	table.clear(hiddenInstances)

	for inst, rec in pairs(savedProps) do
		if inst then
			for prop, value in pairs(rec) do
				pcall(function() inst[prop] = value end)
			end
		end
	end
	table.clear(savedProps)

	if Terrain then
		setTerrainDetail(3)
	end
end

